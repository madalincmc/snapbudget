# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Auth, Database, Storage)
# Project Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct (non-pooled) Postgres connection, used by `npm run db:migrate` and the
# scripts/ test flows. Project Settings > Database > Connection string
POSTGRES_URL_NON_POOLING=

# Google OAuth (used by Supabase Auth for "Login with Google")
# Configure in Google Cloud Console, wire into Supabase Auth > Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Vision API (receipt OCR)
# Service account JSON, base64-encoded, from Google Cloud Console
GOOGLE_VISION_CREDENTIALS_BASE64=

# Stripe (subscriptions)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
